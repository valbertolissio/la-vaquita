{
  "expo": {
    "name": "La Vaquita",
    "slug": "la-vaquita",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1b1240"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lavaquita.app"
    },
    "android": {
      "package": "com.lavaquita.app",
      "adaptiveIcon": {
        "backgroundColor": "#1b1240"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ]
  }
}
