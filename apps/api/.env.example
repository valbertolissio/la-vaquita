DATABASE_URL="postgresql://usuario:password@localhost:5432/la_vaquita?schema=public"
JWT_SECRET="cambiar-este-secreto-en-produccion"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# URL pública de la web, para armar el link de las invitaciones por email.
WEB_URL="http://localhost:5173"

# Envío de invitaciones por email vía Gmail SMTP (opcional: si no se configuran,
# la app sigue funcionando igual, solo no manda el email — queda el link para
# compartir a mano). Se genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (necesita verificación en 2 pasos).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
