// Modelo de base de datos de La Vaquita
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuarios

model Usuario {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  nickname     String?
  avatarColor  String?  @map("avatar_color")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tripsCreated     Proyecto[]            @relation("CreadorDelProyecto")
  tripMemberships  Participante[]
  expensePayments  PagadorDelGasto[]
  expensesCreated  Gasto[]               @relation("CreadorDelGasto")
  expenseSplits    DivisionDelGasto[]
  tasksAssigned    Tarea[]               @relation("ResponsableDeTarea")
  tasksCreated     Tarea[]               @relation("CreadorDeTarea")
  invitationsSent  Invitacion[]          @relation("QuienInvita")
  taskCompletions  TareaCompletada[]
  paymentsSent     Pago[]                @relation("QuienPaga")
  paymentsReceived Pago[]                @relation("QuienCobra")
  passwordResets   TokenDeRecuperacion[]

  @@map("users")
}

model TokenDeRecuperacion {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@map("password_reset_tokens")
}

// Proyectos

model Proyecto {
  id          String   @id @default(uuid())
  name        String
  description String?
  coverImage  String?  @map("cover_image")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  currency    String   @default("ARS")
  createdById String   @map("created_by")
  createdBy   Usuario  @relation("CreadorDelProyecto", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     Participante[]
  expenses    Gasto[]
  tasks       Tarea[]
  invitations Invitacion[]
  categories  Categoria[]
  payments    Pago[]

  @@map("trips")
}

enum TripRole {
  ORGANIZER
  MEMBER
}

// Tabla puente: participantes de un proyecto
model Participante {
  id       String   @id @default(uuid())
  tripId   String   @map("trip_id")
  trip     Proyecto @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     Usuario  @relation(fields: [userId], references: [id])
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  // El saldo (a favor / en contra) se calcula a partir de Gasto + DivisionDelGasto,
  // no se almacena de forma redundante.

  @@unique([tripId, userId])
  @@map("trip_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Invitacion {
  id          String           @id @default(uuid())
  tripId      String           @map("trip_id")
  trip        Proyecto         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  email       String?
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @map("invited_by")
  invitedBy   Usuario          @relation("QuienInvita", fields: [invitedById], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")
  expiresAt   DateTime         @map("expires_at")

  @@map("invitations")
}

// Categorías de gasto (por proyecto, con un conjunto por defecto al crearlo)

model Categoria {
  id     String   @id @default(uuid())
  tripId String   @map("trip_id")
  trip   Proyecto @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name   String
  icon   String?
  color  String?

  expenses Gasto[]

  @@unique([tripId, name])
  @@map("categories")
}

// Gastos

enum ExpenseSource {
  MANUAL
  OCR
}

model Gasto {
  id          String        @id @default(uuid())
  tripId      String        @map("trip_id")
  trip        Proyecto      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal       @db.Decimal(12, 2)
  categoryId  String?       @map("category_id")
  category    Categoria?    @relation(fields: [categoryId], references: [id])
  createdById String        @map("created_by")
  createdBy   Usuario       @relation("CreadorDelGasto", fields: [createdById], references: [id])
  source      ExpenseSource @default(MANUAL)
  receiptUrl  String?       @map("receipt_url")
  notes       String?
  expenseDate DateTime      @default(now()) @map("expense_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  splits DivisionDelGasto[]
  payers PagadorDelGasto[]

  @@map("expenses")
}

// División del gasto entre integrantes ("¿entre quiénes se divide?")
model DivisionDelGasto {
  id         String  @id @default(uuid())
  expenseId  String  @map("expense_id")
  expense    Gasto   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String  @map("user_id")
  user       Usuario @relation(fields: [userId], references: [id])
  amountOwed Decimal @map("amount_owed") @db.Decimal(12, 2)

  @@unique([expenseId, userId])
  @@map("expense_splits")
}

// Quién puso el dinero del gasto. Admite varios pagadores; la suma de los
// aportes debe coincidir con el total, lo que se valida en el servidor.
model PagadorDelGasto {
  id        String  @id @default(uuid())
  expenseId String  @map("expense_id")
  expense   Gasto   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      Usuario @relation(fields: [userId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@unique([expenseId, userId])
  @@map("expense_payers")
}

// Pagos entre participantes (saldar cuentas)

// Registra que alguien ya le pagó (efectivo, transferencia, etc.) a otro
// integrante para saldar parte de su deuda. Es la única forma de "resetear"
// un saldo: el saldo siempre se recalcula a partir de expenses + payments,
// nunca se guarda de forma redundante.
model Pago {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  trip       Proyecto @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String   @map("from_user_id")
  fromUser   Usuario  @relation("QuienPaga", fields: [fromUserId], references: [id])
  toUserId   String   @map("to_user_id")
  toUser     Usuario  @relation("QuienCobra", fields: [toUserId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("payments")
}

// Tareas

enum TaskStatus {
  PENDING
  DONE
}

enum AssignmentType {
  MANUAL
  ROTATING
}

model Tarea {
  id              String           @id @default(uuid())
  tripId          String           @map("trip_id")
  trip            Proyecto         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assignmentType  AssignmentType   @default(MANUAL) @map("assignment_type")
  assignedToId    String?          @map("assigned_to")
  assignedTo      Usuario?         @relation("ResponsableDeTarea", fields: [assignedToId], references: [id])
  rotationGroupId String?          @map("rotation_group_id")
  rotationGroup   GrupoDeRotacion? @relation(fields: [rotationGroupId], references: [id])
  // Modo manual: se pueden fijar startDate y/o dueDate como fechas de referencia.
  // Modo cronómetro (timeTracked): solo importa startDate — el tiempo insumido se
  // calcula al completar la tarea (o cada turno, si es rotativa) y queda guardado
  // en TareaCompletada.durationSeconds.
  startDate       DateTime?        @map("start_date")
  dueDate         DateTime?        @map("due_date")
  timeTracked     Boolean          @default(false) @map("time_tracked")
  status          TaskStatus       @default(PENDING)
  createdById     String           @map("created_by")
  createdBy       Usuario          @relation("CreadorDeTarea", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  completions TareaCompletada[]

  @@map("tasks")
}

// Grupo de turnos rotativos
model GrupoDeRotacion {
  id          String   @id @default(uuid())
  tripId      String   @map("trip_id")
  name        String
  memberOrder String[] @map("member_order") // array ordenado de userId
  cursor      Int      @default(0) // índice del próximo turno

  tasks Tarea[]

  @@map("rotation_groups")
}

model TareaCompletada {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  task            Tarea    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedById   String   @map("completed_by")
  completedBy     Usuario  @relation(fields: [completedById], references: [id])
  completedAt     DateTime @default(now()) @map("completed_at")
  durationSeconds Int?     @map("duration_seconds")

  @@map("task_completions")
}
